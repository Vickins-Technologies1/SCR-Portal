# Daraja credentials are server-side only. Never commit a real .env file.
# These env vars are only the backend fallback for single-account installs.
# Multi-account shortcode selection should come from the database/config portal.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_BASE_URL=https://your-public-https-host.example
MPESA_ENCRYPTION_SECRET=

# KopoKopo invoice payments. Keep credentials server-side only.
KOPOKOPO_ENVIRONMENT=sandbox
KOPOKOPO_OAUTH_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_API_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_API_KEY=
KOPOKOPO_CALLBACK_BASE_URL=https://your-public-https-host.example

# Existing provider integrations (only required when enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_WEB=https://your-public-https-host.example/api/auth/google/callback
# The Android app uses the web client ID as the server/audience ID for its native ID token.
# Create the Android OAuth client separately with package com.soranapropertymanagers.app and its SHA-1.

KOPOKOPO_TILL_NUMBER=
KOPOKOPO_PASSKEY=
TUMA_CALLBACK_BASE_URL=
REFERRAL_ATTRIBUTION_DAYS=30
REFERRAL_SUBSCRIPTION_REWARD_MONTHS=1
REFERRAL_CASH_COMMISSION_AMOUNT=500
REFERRAL_MINIMUM_PAYOUT=1000
REFERRAL_REQUIRE_PAID_SUBSCRIPTION=true

# Sorana Lifetime one-time package. Set the price before enabling checkout.
LIFETIME_PRICE_KES=0
LIFETIME_CURRENCY=KES
LIFETIME_ENABLED=true
LIFETIME_PROPERTY_LIMIT=-1
LIFETIME_UNIT_LIMIT=-1
LIFETIME_TENANT_LIMIT=-1
LIFETIME_STAFF_LIMIT=-1
LIFETIME_AIRBNB_LIMIT=-1
LIFETIME_STORAGE_LIMIT=-1
LIFETIME_MONTHLY_TRANSACTION_LIMIT=-1

# Existing Sorana SMTP email provider (set these in the deployment environment)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sorana-sender@gmail.com
SMTP_PASS=your-gmail-app-password

# Centralized production error monitoring (reuses the SMTP provider above)
ERROR_ALERTS_ENABLED=true
ERROR_ALERT_EMAIL=techvickins@gmail.com
ERROR_ALERT_ENVIRONMENTS=production
ERROR_ALERT_REPEAT_THRESHOLD=25
ERROR_ALERT_COOLDOWN_MS=900000
ERROR_MONITOR_INTERNAL_KEY=replace-with-a-long-random-secret
